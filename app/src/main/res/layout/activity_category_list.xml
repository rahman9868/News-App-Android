<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.CategoryListActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:orientation="horizontal"
            android:background="@color/colorPrimaryDark"
            android:paddingTop="16dp"
            android:paddingStart="8dp">


            <androidx.cardview.widget.CardView
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:cardCornerRadius="38dp"
                android:layout_marginEnd="@dimen/activity_vertical_margin"
                android:elevation="0dp">


                <ImageView
                    android:id="@+id/img_user"
                    android:src="@drawable/placeholder_image"
                    android:scaleType="centerCrop"
                    android:layout_width="30dp"
                    android:layout_height="30dp"></ImageView>


            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/welcomeTextView"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:fontFamily="@font/chewy"
                android:text="Hello, Mala!"
                android:textColor="@color/white"
                android:textSize="22dp"/>

            <ImageView
                android:id="@+id/viewProfile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_collections_bookmark_black_24dp"
                android:padding="4dp"
                android:layout_marginEnd="16dp"/>


        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvListCafe"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:layout_gravity="center"
            tools:listitem="@layout/item_cafe_list"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>