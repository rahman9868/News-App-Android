<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".view.detail.OverviewFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/layout_between_padding_small"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.8"
            android:orientation="vertical"
            android:layout_height="50dp">


            <TextView
                android:id="@+id/txtType"
                tools:text="Coffee Shop"
                android:textSize="10sp"
                app:drawableStartCompat="@drawable/ic_type"
                android:drawablePadding="@dimen/layout_between_padding_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtStatus"
                    android:text="Open Now"
                    android:textSize="10sp"
                    android:textColor="@color/green"
                    app:drawableStartCompat="@drawable/ic_time"
                    android:drawablePadding="@dimen/layout_between_padding_small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtTime"
                    tools:text="08:00 - 22:00"
                    android:layout_marginStart="@dimen/layout_between_padding"
                    android:textSize="10sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txtLocation"
                tools:text="Jl. Cipete Raya No. 66, Jakarta Selatan"
                android:textSize="10sp"
                app:drawableStartCompat="@drawable/ic_location"
                android:drawablePadding="@dimen/layout_between_padding_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>



        <LinearLayout
            android:layout_width="wrap_content"
            android:background="@drawable/bg_rate"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:layout_gravity="center"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtRate"
                tools:text="4.8"
                android:textColor="@color/black_90"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/ic_rate"
                android:drawablePadding="@dimen/layout_between_padding_small"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_weight="0.5"
                android:layout_height="0dp"/>

        </LinearLayout>


    </LinearLayout>

</FrameLayout>