<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:orientation="horizontal"
            android:background="@color/colorPrimaryDark"
            android:paddingTop="16dp"
            android:paddingStart="8dp">


            <androidx.cardview.widget.CardView
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:cardCornerRadius="38dp"
                android:layout_marginEnd="@dimen/activity_vertical_margin"
                android:elevation="0dp">


                <ImageView
                    android:id="@+id/img_user"
                    android:src="@drawable/placeholder_image"
                    android:scaleType="centerCrop"
                    android:layout_width="30dp"
                    android:layout_height="30dp"></ImageView>


            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/welcomeTextView"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:fontFamily="@font/chewy"
                android:text="Hello, Mala!"
                android:textColor="@color/white"
                android:textSize="22dp"/>

            <ImageView
                android:id="@+id/viewProfile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_collections_bookmark_black_24dp"
                android:padding="4dp"
                android:layout_marginEnd="16dp"/>


        </LinearLayout>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="350dp"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/layout_between_padding"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edit_text"
            android:hint="Search"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategory"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="3"
            android:layout_gravity="center"
            tools:itemCount="6"
            tools:listitem="@layout/item_category_cafe"
            style="@style/fab_action"
            />

        <androidx.cardview.widget.CardView
            android:layout_width="325dp"
            android:layout_height="250dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/activity_vertical_margin_large"
            app:cardCornerRadius="5dp"
            android:elevation="50dp"
            app:cardBackgroundColor="@color/white"
            android:theme="@style/AppTheme">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/layout_between_padding"
                android:orientation="vertical">

                <TextView
                    android:text="Recommended Places"
                    android:textSize="18sp"
                    android:textColor="@color/colorPrimaryDark"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="The best places to eat near you"
                    android:textSize="16sp"
                    android:textColor="@color/colorPrimaryDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <ImageView
                    android:id="@+id/ivRecommended"
                    android:layout_width="match_parent"
                    android:layout_height="128dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/layout_between_padding"
                    tools:src="@drawable/pic_cafe_1"
                    android:scaleType="fitXY"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/layout_between_padding_small"
                    android:layout_height="75dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.8"
                        android:orientation="vertical"
                        android:layout_height="50dp">

                        <TextView
                            android:id="@+id/txtName"
                            tools:text="TITIK TEMU CAFE - CIPETE"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="@dimen/layout_between_padding_small"
                            android:textColor="@color/colorPrimaryDark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/txtTime"
                            tools:text="08:00 - 22:00"
                            android:textSize="10sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/txtLocation"
                            tools:text="Jl. Cipete Raya No. 66, Jakarta Selatan"
                            android:textSize="10sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>



                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.15"
                        android:background="@color/grey"
                        android:orientation="vertical"
                        android:padding="2dp"
                        android:gravity="center"
                        android:layout_height="50dp">

                        <TextView
                            android:id="@+id/txtRate"
                            tools:text="4.8"
                            android:textColor="@color/black_90"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_weight="0.5"
                            android:layout_height="0dp"/>

                        <TextView
                            android:id="@+id/txtReviews"
                            tools:text="2.511"
                            android:textColor="@color/black_90"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:background="@drawable/bg_reviews"
                            android:layout_width="match_parent"
                            android:layout_weight="0.5"
                            android:layout_height="0dp"/>

                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


    </LinearLayout>
</androidx.core.widget.NestedScrollView>